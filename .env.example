# Application
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# OpenAI-compatible Chat and Embedding API
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# Query intent router (Alibaba Cloud Bailian / Qwen OpenAI-compatible API)
INTENT_API_KEY=replace-with-your-bailian-api-key
INTENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTENT_MODEL=qwen-plus
INTENT_TIMEOUT_SECONDS=10

# Local MySQL demo database (use the read-only account created by db/03_grants.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chatbi_reader
DB_PASSWORD=replace-with-a-local-read-only-password
DB_NAME=chatbi_mvp
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=8
DB_WRITE_TIMEOUT=8
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_SLOW_QUERY_THRESHOLD_MS=200

# Query guardrails
QUERY_MAX_LENGTH=1000
QUERY_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=10
QUERY_ALLOWED_TABLES=dim_customers,dim_products,sales_orders,exchange_rates,finance_expenses,dim_regions,dim_countries,dim_departments,dim_employees,dim_suppliers,dim_warehouses,dim_sales_channels,dim_currencies,dim_calendar,dim_cost_centers,purchase_orders,purchase_order_items,sales_order_items,inventory_balances,inventory_transactions,production_orders,production_outputs,quality_inspections,equipment,equipment_maintenance,shipments,shipment_items,customer_payments,supplier_payments,budgets
QUERY_SENSITIVE_FIELDS=

# Local schema indexes
CHROMA_PERSIST_DIR=chroma_db
SCHEMA_INDEX_VERSION=1
SIMPLE_CHROMA_DIR=chroma_db/simple_semantic
SIMPLE_CHROMA_HOST=127.0.0.1
SIMPLE_CHROMA_PORT=18081
SIMPLE_CHROMA_SSL=false
SIMPLE_SCHEMA_INDEX_VERSION=3
SIMPLE_INDICATOR_MAX_DISTANCE=0.80
SIMPLE_TABLE_TOP_K=5
SIMPLE_FIELD_TOP_K=12

# Feature switches
FEATURE_FEW_SHOT=true
FEATURE_RULES=true
FEATURE_GUARDS=true
FEATURE_INDICATOR_KNOWLEDGE=true
FEATURE_SCHEMA_LINKING=true
FEATURE_INTENT_ROUTER=true
# Chroma runs in the Linux VM and is reached through the local-only forwarded port above.
FEATURE_SIMPLE_CHROMA=true
FEATURE_COMPLEX_PLAN_EXECUTE=true
COMPLEX_PLAN_MAX_STEPS=6
COMPLEX_PLAN_REPAIR_ATTEMPTS=1
COMPLEX_SUMMARY_ROWS_PER_STEP=30
COMPLEX_STEP_RETRY=1
